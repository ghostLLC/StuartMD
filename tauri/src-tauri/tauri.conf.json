{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StuartMD",
  "version": "3.5.5",
  "identifier": "com.stuartmd.app",
  "build": {
    "frontendDist": "../../web",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StuartMD",
        "width": 1100,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https: asset: stuart:; connect-src 'self' https: http: ipc: tauri:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../../assets/app.ico"
    ],
    "resources": {
      "../../samples/示例文档.md": "samples/示例文档.md",
      "../../samples/欢迎使用 StuartMD.md": "samples/欢迎使用 StuartMD.md",
      "../../assets/file-md.ico": "file-md.ico",
      "../../assets/file-pdf.ico": "file-pdf.ico"
    },
    "fileAssociations": [
      {
        "name": "Markdown",
        "ext": ["md", "markdown", "mdown", "mkd"],
        "role": "Editor",
        "description": "Markdown 文档"
      },
      {
        "name": "PDF",
        "ext": ["pdf"],
        "role": "Viewer",
        "description": "PDF 文档"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "../../assets/app.ico",
        "uninstallerIcon": "../../assets/app.ico"
      }
    }
  }
}
